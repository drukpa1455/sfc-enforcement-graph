{
  "name": "sfc-enforcement-graph",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run docs && concurrently -k -n api,web \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite\"",
    "build": "tsc -b && npm run docs && vite build",
    "docs": "uv run --frozen mkdocs build --strict",
    "docs:serve": "uv run --frozen mkdocs serve --strict",
    "lint": "oxlint",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "node --import tsx --test shared/*.test.ts server/*.test.ts web/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/react": "^4.0.65",
    "@hono/node-server": "^2.1.0",
    "ai": "^7.0.62",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-cores": "^0.0.1",
    "graphology-metrics": "^2.4.0",
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
